# Local paths and settings; copy to .env.local and keep that file untracked.
STT_DATA_DIR=D:/stt-services-data
STT_MODEL=turbo
STT_CPU_THREADS=4
STT_BEAM_SIZE=5
STT_DEVICE=cpu
STT_DEVICE_INDEX=0
STT_COMPUTE_TYPE=int8
STT_MODE=sequential
# Sequential mode defaults to batch size 1; leave STT_BATCH_SIZE unset.
STT_LANGUAGE_MODE=auto
STT_CONDITION_ON_PREVIOUS_TEXT=true
STT_TEMPERATURE_ZERO=false
STT_VAD_ENABLED=true
STT_VAD_THRESHOLD=0.5
STT_VAD_MIN_SILENCE_DURATION_MS=2000
STT_VAD_SPEECH_PAD_MS=400
# Set one of these for a separate hint experiment. Do not set both together.
# STT_INITIAL_PROMPT=
# STT_HOTWORDS=
# CUDA trials require explicit device and supported precision, for example:
# STT_DEVICE=cuda
# STT_COMPUTE_TYPE=float16
HF_HOME=D:/stt-services-data/cache/huggingface
UV_CACHE_DIR=D:/stt-services-data/cache/uv
PYTHONUTF8=1
